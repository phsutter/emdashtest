---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, content } =
	Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const menu = menuResult.data;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<style is:global>
		:root {
		--primary: #b08b57;
		--dark: #222;
		--light: #fff;
		--muted: #f5f5f5;
		}

		body {
		margin: 0;
		font-family: Inter, sans-serif;
		color: var(--dark);
		background: white;
		line-height: 1.6;
		}

		header {
		background: white;
		border-bottom: 1px solid #e5e5e5;
		position: sticky;
		top: 0;
		z-index: 100;
		}

		nav {
		max-width: 1200px;
		margin: 0 auto;
		padding: 1rem 2rem;

		display: flex;
		align-items: center;
		gap: 1.5rem;
		}

		nav a:first-child {
		margin-right: auto;
		}

		nav a {
		text-decoration: none;
		color: var(--dark);
		font-weight: 500;
		}

		nav a:hover {
		color: var(--primary);
		}

		main {
		max-width: 1200px;
		margin: 0 auto;
		padding: 3rem 2rem;
		}

		h1,h2,h3 {
		font-family: Georgia, serif;
		}

		img {
		max-width: 100%;
		height: auto;
		}
		</style>
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<header>
			<nav>
				<a href="/">
					{
						siteLogo ? (
							<img
								src={siteLogo.url}
								alt={siteLogo.alt || siteTitle}
								style="height:48px;width:auto;margin:-8px 0;display:block;"
							/>
						) : (
							siteTitle
						)
					}
				</a>
				{
					menu?.items.map((item) => (
						<a
							href={item.url}
							target={item.target}
							rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
						>
							{item.label}
						</a>
					))
				}
				<LiveSearch placeholder="Search..." collections={["posts", "pages"]} />
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
