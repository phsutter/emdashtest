---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const { title, pageTitle, description, image, canonical, content } =
	Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const menu = menuResult.data;
const normalizePath = (path: string) => path.replace(/\/+$/, "") || "/";
const currentPath = normalizePath(Astro.url.pathname);
const isCurrentMenuItem = (url: string) => {
	if (!url.startsWith("/")) return false;
	const itemPath = normalizePath(url);
	return (
		currentPath === itemPath ||
		(itemPath !== "/" && currentPath.startsWith(`${itemPath}/`))
	);
};

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<script is:inline>
			(() => {
				const storageKey = "emdash-theme-preference";
				const valid = new Set(["system", "dark", "light", "neo-day"]);
				const savedPreference = localStorage.getItem(storageKey);
				const preference = valid.has(savedPreference ?? "")
					? savedPreference
					: "system";
				const systemTheme = window.matchMedia("(prefers-color-scheme: light)")
					.matches
					? "light"
					: "dark";
				const resolvedTheme = preference === "system" ? systemTheme : preference;
				document.documentElement.dataset.theme = resolvedTheme;
			})();
		</script>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<header class="site-header">
			<nav class="site-nav">
				<a href="/" class="site-brand">
					{
						siteLogo ? (
							<img
								src={siteLogo.url}
								alt={siteLogo.alt || siteTitle}
							/>
						) : (
							siteTitle
						)
					}
				</a>
				{
					menu?.items.map((item) => (
						<a
							href={item.url}
							class:list={[
								"site-nav-link",
								{ active: isCurrentMenuItem(item.url) },
							]}
							target={item.target}
							rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
						>
							{item.label}
						</a>
					))
				}
				<label class="theme-picker" for="theme-select">
					Theme
					<select id="theme-select" data-theme-select>
						<option value="system">System</option>
						<option value="dark">Dark</option>
						<option value="light">Light</option>
						<option value="neo-day">Neo Day</option>
					</select>
				</label>
				<div class="search-shell">
					<LiveSearch placeholder="Search..." collections={["posts", "pages"]} />
				</div>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<EmDashBodyEnd page={pageCtx} />
		<script is:inline>
			(() => {
				const storageKey = "emdash-theme-preference";
				const root = document.documentElement;
				const select = document.querySelector("[data-theme-select]");
				if (!(select instanceof HTMLSelectElement)) return;
				const valid = new Set(["system", "dark", "light", "neo-day"]);
				const mediaQuery = window.matchMedia("(prefers-color-scheme: light)");

				const getSystemTheme = () => (mediaQuery.matches ? "light" : "dark");
				const getPreference = () => {
					const saved = localStorage.getItem(storageKey);
					return valid.has(saved ?? "") ? saved : "system";
				};
				const resolveTheme = (preference) =>
					preference === "system" ? getSystemTheme() : preference;
				const applyTheme = (preference) => {
					root.dataset.theme = resolveTheme(preference);
					select.value = preference;
				};

				applyTheme(getPreference());

				select.addEventListener("change", () => {
					const nextPreference = valid.has(select.value)
						? select.value
						: "system";
					localStorage.setItem(storageKey, nextPreference);
					applyTheme(nextPreference);
				});

				mediaQuery.addEventListener("change", () => {
					const preference = getPreference();
					if (preference === "system") {
						applyTheme("system");
					}
				});
			})();
		</script>
	</body>
</html>
