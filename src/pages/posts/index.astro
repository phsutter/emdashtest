---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import { Image } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Single batched query for tags across every post, instead of calling
// getEntryTerms() per post (which would be N round-trips).
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);
const postsWithTags = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
}));
---

<Base title="All Posts">
	<header class="archive-head">
		<h1>Posts</h1>
		<p>Freshly published stories, insights, and updates.</p>
	</header>

	{
		postsWithTags.length === 0 ? (
			<p>No posts yet.</p>
		) : (
			<ul class="post-grid">
				{postsWithTags.map(({ post, tags }) => (
					<li class="post-card">
						<a class="post-card-link" href={`/posts/${post.id}`}>
							{post.data.featured_image && (
								<div class="post-card-media" {...post.edit.featured_image}>
									<Image image={post.data.featured_image} />
								</div>
							)}
							<div class="post-card-body">
								<h2 class="post-card-title" {...post.edit.title}>
									{post.data.title}
								</h2>
								{post.data.excerpt && (
									<p {...post.edit.excerpt}>{post.data.excerpt}</p>
								)}
								{tags.length > 0 && (
									<div class="chip-list">
										{tags.map((t) => (
											<a class="chip" href={`/tag/${t.slug}`}>
												#{t.label}
											</a>
										))}
									</div>
								)}
							</div>
						</a>
					</li>
				))}
			</ul>
		)
	}
	<nav class="pagination" aria-label="Pagination">
		{cursor && <a href="/posts">First page</a>}
		{
			nextCursor && (
				<a href={`/posts?cursor=${encodeURIComponent(nextCursor)}`}>
					Next page
				</a>
			)
		}
	</nav>
</Base>
