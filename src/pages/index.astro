---
import { getEmDashCollection, getSiteSettings } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
  orderBy: { published_at: "desc" },
  limit: 10,
});

const { siteTitle, siteTagline } = resolveStarterSiteIdentity(
  await getSiteSettings(),
);

if (Astro.cache?.enabled) {
  Astro.cache.set(cacheHint);
}
---

<Base title={siteTitle} description={siteTagline}>
  <section class="hero">
    <div class="hero-content">
      <h1>{siteTitle}</h1>
      <p>{siteTagline}</p>
    </div>
  </section>

  <section>
    <h2>Aktuelles</h2>

    {
      posts.length === 0 ? (
        <p>
          Noch keine Beiträge vorhanden.{" "}
          <a href="/_emdash/admin/content/posts/new">
            Ersten Beitrag erstellen
          </a>
        </p>
      ) : (
        <div class="news-grid">
          {posts.map((post) => (
            <article class="news-card">
              <a href={`/posts/${post.id}`}>
                {post.data.featured_image && (
                  <div {...post.edit.featured_image}>
                    <Image image={post.data.featured_image} />
                  </div>
                )}

                <h3 {...post.edit.title}>
                  {post.data.title}
                </h3>
              </a>

              {post.data.excerpt && (
                <p {...post.edit.excerpt}>
                  {post.data.excerpt}
                </p>
              )}

              {post.data.publishedAt && (
                <time datetime={post.data.publishedAt.toISOString()}>
                  {post.data.publishedAt.toLocaleDateString("de-CH", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
              )}
            </article>
          ))}
        </div>
      )
    }
  </section>

  <style>
    .hero {
      background:
        linear-gradient(
          rgba(0, 0, 0, 0.45),
          rgba(0, 0, 0, 0.45)
        ),
        url("/hero.jpg");

      background-size: cover;
      background-position: center;

      height: 70vh;

      display: flex;
      align-items: center;
      justify-content: center;

      text-align: center;
      color: white;
      border-radius: 12px;
      margin-bottom: 4rem;
    }

    .hero-content {
      max-width: 800px;
      padding: 2rem;
    }

    .hero h1 {
      font-size: clamp(2.5rem, 6vw, 5rem);
      margin-bottom: 1rem;
    }

    .hero p {
      font-size: 1.25rem;
      margin: 0;
    }

    h2 {
      margin-bottom: 2rem;
    }

    .news-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 2rem;
    }

    .news-card {
      background: white;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
      transition: transform 0.2s ease;
    }

    .news-card:hover {
      transform: translateY(-4px);
    }

    .news-card a {
      color: inherit;
      text-decoration: none;
    }

    .news-card h3 {
      padding: 1rem;
      margin: 0;
    }

    .news-card p {
      padding: 0 1rem;
    }

    .news-card time {
      display: block;
      padding: 1rem;
      color: #666;
      font-size: 0.9rem;
    }

    .news-card img {
      width: 100%;
      height: 250px;
      object-fit: cover;
      display: block;
    }
  </style>
</Base>