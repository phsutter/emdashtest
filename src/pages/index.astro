---
import { getEmDashCollection, getEmDashEntry, getSiteSettings } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const [postsResult, homeResult] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 10,
	}),
	getEmDashEntry("pages", "home"),
]);
const { entries: posts, cacheHint } = postsResult;
const homePage = homeResult.entry;

const { siteTitle, siteTagline } = resolveStarterSiteIdentity(
	await getSiteSettings(),
);

if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	if (homeResult.cacheHint) {
		Astro.cache.set(homeResult.cacheHint);
	}
}
---

<Base
	title={siteTitle}
	description={siteTagline}
	content={
		homePage
			? { collection: "pages", id: homePage.data.id, slug: homePage.id }
			: undefined
	}
>
	<section class="hero-panel">
		<span class="hero-kicker">Future-ready publishing</span>
		{homePage ? (
			<>
				<h1 {...homePage.edit.title}>{homePage.data.title}</h1>
				<div class="content-prose" {...homePage.edit.content}>
					<PortableText value={homePage.data.content} />
				</div>
			</>
		) : (
			<>
				<h1>{siteTitle}</h1>
				<p>{siteTagline}</p>
			</>
		)}
	</section>

	<section aria-labelledby="latest-posts">
		<h2 id="latest-posts">Latest stories</h2>

		{
			posts.length === 0 ? (
				<p>
					Noch keine Beiträge vorhanden.{" "}
					<a href="/_emdash/admin/content/posts/new">
						Ersten Beitrag erstellen
					</a>
				</p>
			) : (
				<ul class="post-grid">
					{posts.map((post) => (
						<li class="post-card">
							<a class="post-card-link" href={`/posts/${post.id}`}>
								{post.data.featured_image && (
									<div class="post-card-media" {...post.edit.featured_image}>
										<Image image={post.data.featured_image} />
									</div>
								)}

								<div class="post-card-body">
									<h3 class="post-card-title" {...post.edit.title}>
										{post.data.title}
									</h3>

									{post.data.excerpt && (
										<p {...post.edit.excerpt}>
											{post.data.excerpt}
										</p>
									)}

									{post.data.publishedAt && (
										<div class="post-card-meta">
											<time datetime={post.data.publishedAt.toISOString()}>
												{post.data.publishedAt.toLocaleDateString("de-CH", {
													year: "numeric",
													month: "long",
													day: "numeric",
												})}
											</time>
										</div>
									)}
								</div>
							</a>
						</li>
					))}
				</ul>
			)
		}
	</section>
</Base>